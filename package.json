{
  "name": "baseballstattrack",
  "version": "0.1.0",
  "private": true,
  "description": "Event-oriented baseball scorekeeping and statistics platform.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run db:validate && npm run build"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  },
  "dependencies": {
    "@prisma/client": "7.9.0",
    "@prisma/adapter-pg": "7.9.0",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "dotenv": "17.4.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.0": true,
    "unrs-resolver@1.12.2": true
  }
}
