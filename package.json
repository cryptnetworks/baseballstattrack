{
  "name": "baseballstattrack",
  "version": "0.1.0",
  "private": true,
  "description": "Event-oriented baseball scorekeeping and statistics platform.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:verify": "node scripts/verify-migration.mjs",
    "db:representability": "node scripts/verify-relational-representability.mjs",
    "db:backup": "bash scripts/backup-database.sh",
    "db:restore": "bash scripts/restore-database.sh",
    "db:restore:verify": "bash scripts/verify-backup-restore.sh",
    "db:storage:check": "bash scripts/check-database-storage.sh",
    "policy:validate": "node scripts/verify-defect-policy.mjs",
    "docs:wiki:validate": "node scripts/publish-docs-wiki.mjs --mode validate",
    "docs:wiki:dry-run": "node scripts/publish-docs-wiki.mjs --mode dry-run",
    "docs:wiki:publish": "node scripts/publish-docs-wiki.mjs --mode publish",
    "docs:wiki:workflow:validate": "node scripts/verify-docs-wiki-workflow.mjs",
    "container:config": "docker compose --env-file compose.production.env.example config --quiet",
    "container:production:build": "bash scripts/build-production-images.sh",
    "container:build": "docker build --target runtime --tag baseballstattrack:local .",
    "container:verify": "bash scripts/container-smoke.sh",
    "release:rehearse": "bash scripts/release-rehearsal.sh",
    "reliability:drill": "bash scripts/verify-reliability-drill.sh",
    "container:scan": "docker scout cves --exit-code --only-severity critical,high local://baseballstattrack:local",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "api:contract": "node scripts/verify-statistics-api-contract.mjs",
    "api:contract:write": "node scripts/verify-statistics-api-contract.mjs --write",
    "experience:measure": "EXPERIENCE_MEASURE=1 vitest run tests/quality/experience-measurement.test.ts --reporter=verbose",
    "experience:verify": "node scripts/verify-experience-budgets.mjs",
    "pwa:verify": "node scripts/verify-pwa.mjs",
    "performance:measure": "EXPERIENCE_MEASURE=1 PERFORMANCE_MEASURE=1 vitest run tests/quality/experience-measurement.test.ts tests/quality/production-workload-budgets.integration.test.ts --reporter=verbose",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run policy:validate && npm run docs:wiki:validate && npm run api:contract && npm run db:validate && npm run build && npm run experience:verify && npm run pwa:verify && npm run audit:prod"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "find-my-way": "9.7.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.0": true,
    "unrs-resolver@1.12.2": true
  }
}
