# Production application bootstrap and secret template.
# Copy to a protected file outside the repository and set APP_ENV_FILE to it.
# The Compose deployment supplies NODE_ENV, PORT, DATABASE_URL, DIRECT_URL, and
# the image-pinned REQUIRED_DATABASE_MIGRATION. Non-secret Account behavior is
# managed only at /settings/configuration and is intentionally absent here.

# Required public deployment topology (non-secret; deployment-owned).
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.example.com
AUTHENTICATION_ENABLED_PROVIDERS=google
OAUTH_CALLBACK_URL=https://app.example.com/auth/callback
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id

# Required authentication secret (secret-manager-owned).
AUTHENTICATION_ENCRYPTION_KEY=replace-with-exactly-32-base64url-encoded-random-bytes
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret

# Optional authentication adapters. Add a provider to
# AUTHENTICATION_ENABLED_PROVIDERS only after supplying its complete bootstrap.
# Client, issuer, team, key, and redirect identifiers are non-secret topology;
# client secrets and private keys remain external secret material.
AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/baseball/
AUTHENTIK_OAUTH_CLIENT_ID=replace-with-authentik-client-id
AUTHENTIK_OAUTH_CLIENT_SECRET=replace-with-authentik-client-secret
DISCORD_LOGIN_CLIENT_ID=replace-with-discord-login-client-id
DISCORD_LOGIN_CLIENT_SECRET=replace-with-discord-login-client-secret
FACEBOOK_OAUTH_CLIENT_ID=replace-with-facebook-client-id
FACEBOOK_OAUTH_CLIENT_SECRET=replace-with-facebook-client-secret
APPLE_OAUTH_CLIENT_ID=com.example.baseballstattrack
APPLE_OAUTH_TEAM_ID=replace-with-apple-team-id
APPLE_OAUTH_KEY_ID=replace-with-apple-key-id
APPLE_OAUTH_PRIVATE_KEY=replace-with-apple-private-key

# Conditional application credentials (secret-manager-owned). Supply only for
# enabled capabilities; their non-secret behavior and endpoints live in the
# Account configuration revision managed through the admin portal.
WEBHOOK_SIGNING_MASTER_KEY=replace-with-at-least-32-base64url-encoded-bytes
WEBHOOK_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_INGESTION_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_DATA_PROVIDER_API_KEY=replace-with-managed-provider-api-key
# This non-secret origin constrains where the provider credential may be sent.
EXTERNAL_DATA_PROVIDER_ALLOWED_ORIGIN=https://licensed-provider.example
ICS_FEED_SIGNING_KEY=replace-with-at-least-32-random-characters
NOTIFICATION_WORKER_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_EVENT_TOKEN=replace-with-a-different-32-character-token
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
NOTIFICATION_DISCORD_BOT_TOKEN=replace-with-managed-notification-bot-token

# Conditional Discord installation and update credentials. IDs/redirects are
# deployment topology; credential references and provider API URLs are managed
# in the admin configuration revision.
DISCORD_OAUTH_CLIENT_ID=123456789012345678
DISCORD_OAUTH_CLIENT_SECRET=replace-with-discord-oauth-client-secret
DISCORD_INSTALLATION_BOT_TOKEN=replace-with-managed-installation-bot-token
DISCORD_OAUTH_STATE_SECRET=replace-with-a-different-32-character-random-secret
DISCORD_OAUTH_REDIRECT_URI=https://app.example.com/api/admin/discord-installations/callback
DISCORD_UPDATE_EVENT_TOKEN=replace-with-a-different-32-character-random-secret
DISCORD_UPDATE_WORKER_TOKEN=replace-with-another-32-character-random-secret
DISCORD_STATISTICS_API_TOKEN=replace-with-dedicated-report-view-access-token
DISCORD_UPDATE_BOT_TOKEN=replace-with-managed-update-bot-token
