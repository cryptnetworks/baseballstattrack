# Local-development bootstrap only. Copy to .env.local; never deploy this file.
# The localhost endpoints and synthetic placeholders below are Category 3 values.
# Account behavior still belongs in Settings -> Application configuration.

# Required local deployment identity (non-secret; developer-owned).
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Required local database bootstrap (local credential; never reuse elsewhere).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public

# Required local session encryption. This synthetic value is development-only.
AUTHENTICATION_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE

# Optional local OAuth. Leave the provider list empty until local credentials
# and the loopback callback are registered with the provider.
AUTHENTICATION_ENABLED_PROVIDERS=
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback
GOOGLE_OAUTH_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-local-google-client-secret

# Optional local worker secrets. These synthetic placeholders must never be
# copied to preview or production.
WEBHOOK_SIGNING_MASTER_KEY=local-only-webhook-signing-key-1234567890
WEBHOOK_WORKER_TOKEN=local-only-webhook-worker-token-1234567890
EXTERNAL_INGESTION_WORKER_TOKEN=local-only-ingestion-worker-token-1234567890
ICS_FEED_SIGNING_KEY=local-only-calendar-signing-key-1234567890
NOTIFICATION_WORKER_TOKEN=local-only-notification-worker-token-1234567890
NOTIFICATION_EVENT_TOKEN=local-only-notification-event-token-1234567890
