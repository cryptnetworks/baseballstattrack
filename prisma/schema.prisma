generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
  PENDING_DELETION
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
  REMOVED
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
  MERGED
  RECOVERED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  SUPERSEDED
}

enum MembershipRole {
  OWNER
  ADMINISTRATOR
  COACH_MANAGER
  SCOREKEEPER
  VIEWER
}

enum AuthorizationScope {
  ACCOUNT
  TEAM
  SEASON
  GAME
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RosterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BattingSide {
  LEFT
  RIGHT
  SWITCH
}

enum ThrowingHand {
  LEFT
  RIGHT
}

enum WeatherCondition {
  CLEAR
  PARTLY_CLOUDY
  CLOUDY
  LIGHT_RAIN
  RAIN
  WINDY
  INDOOR
}

enum GameStatus {
  DRAFT
  READY
  IN_PROGRESS
  SUSPENDED
  COMPLETED
  VERIFIED
  CORRECTED
  ABANDONED
  CANCELLED
}

enum GameSide {
  HOME
  AWAY
}

enum BaseballPosition {
  PITCHER
  CATCHER
  FIRST_BASE
  SECOND_BASE
  THIRD_BASE
  SHORTSTOP
  LEFT_FIELD
  CENTER_FIELD
  RIGHT_FIELD
  DESIGNATED_HITTER
  EXTRA_HITTER
}

enum RulesetStatus {
  ACTIVE
  ARCHIVED
}

enum ActorKind {
  USER
  SERVICE
  SYSTEM
}

enum ProjectionScope {
  GAME
  SEASON
}

enum ProjectionStatus {
  PENDING
  BUILDING
  CURRENT
  FAILED
  STALE
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

enum AuditScope {
  ACCOUNT
  SYSTEM
}

enum CorrectionPolicy {
  REPLACE_PLAY
  REPLACE_EVENT_RANGE
  REPLACE_JUDGMENT
  REVERSE_EVENTS
}

enum PrivacyDisplayField {
  PLAYER_DISPLAY_NAME
}

enum DataExportArtifactStatus {
  AVAILABLE
  DOWNLOADED
  CANCELLED
  EXPIRED
  REVOKED
}

enum PrivacyLifecycleTarget {
  ACCOUNT
  USER
  PLAYER
}

enum PrivacyLifecycleStatus {
  REQUESTED
  BLOCKED
  CANCELLED
  COMPLETED
}

enum PrivacyHoldStatus {
  ACTIVE
  RELEASED
}

enum RateLimitScope {
  ACCOUNT
  ACTOR
}

enum RateLimitOverrideStatus {
  ACTIVE
  REVOKED
}

enum WebhookEndpointStatus {
  PENDING_VERIFICATION
  ACTIVE
  REVOKED
}

enum WebhookEventName {
  GAME_VERIFIED
  GAME_CORRECTED
  REPORT_READY
  SEASON_REPORT_UPDATED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  DEAD_LETTER
  CANCELLED
}

enum WebhookAttemptOutcome {
  SUCCEEDED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  CANCELLED
}

enum ProductAnalyticsConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum ExternalDataSourceStatus {
  DISABLED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ExternalIngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExternalProviderRecordStatus {
  PUBLISHED
  QUARANTINED
  SUPERSEDED
}

enum ExternalQuarantineStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CalendarProvider {
  GOOGLE
}

enum CalendarConnectionStatus {
  ACTIVE
  DISCONNECTING
  DISCONNECTED
}

enum CalendarDetailLevel {
  PRIVATE
  OPPONENT
  FULL
}

enum CalendarEventSyncStatus {
  PENDING
  SYNCED
  FAILED
  CONFLICT
  CANCELLED
}

model Account {
  id          String        @id @default(cuid())
  externalId  String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String        @unique
  displayName String
  status      AccountStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  memberships             AccountMembership[]
  invitations             MembershipInvitation[]
  teams                   Team[]
  seasons                 Season[]
  teamSeasons             TeamSeason[]
  players                 Player[]
  rosterEntries           RosterEntry[]
  rulesetVersions         RulesetVersion[]
  games                   Game[]
  gameTeams               GameTeamSnapshot[]
  setupSnapshots          GameSetupSnapshot[]
  lineupSlots             LineupSlotSnapshot[]
  playTransactions        PlayTransaction[]
  sourceEvents            SourceEvent[]
  eventCorrections        EventCorrection[]
  projectionCheckpoints   ProjectionCheckpoint[]
  securityAuditRecords    SecurityAuditRecord[]
  privacyOverlays         PrivacyOverlay[]
  privacyOverlayFields    PrivacyOverlayField[]
  dataExportArtifacts     DataExportArtifact[]
  privacyRequests         PrivacyLifecycleRequest[]
  privacyHolds            PrivacyHold[]
  rateLimitCounters       RateLimitCounter[]
  rateLimitCharges        RateLimitCharge[]
  rateLimitOverrides      RateLimitOverride[]
  webhookEndpoints        WebhookEndpoint[]
  webhookEvents           WebhookEvent[]
  webhookDeliveries       WebhookDelivery[]
  webhookAttempts         WebhookDeliveryAttempt[]
  externalDataSources     ExternalDataSource[]
  externalIngestionRuns   ExternalIngestionRun[]
  externalProviderRecords ExternalProviderRecord[]
  externalQuarantines     ExternalIngestionQuarantine[]
  calendarConnections     CalendarConnection[]
  calendarEventLinks      CalendarEventLink[]
}

model AppUser {
  id              String     @id @default(cuid())
  provider        String
  providerSubject String
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  detachedAt      DateTime?

  memberships             AccountMembership[]
  invitationsReceived     MembershipInvitation[]   @relation("InvitationRecipient")
  invitationsSent         MembershipInvitation[]   @relation("InvitationInviter")
  recordedPlays           PlayTransaction[]        @relation("PlayTransactionActor")
  recordedEvents          SourceEvent[]            @relation("SourceEventActor")
  auditRecords            SecurityAuditRecord[]    @relation("AuditActor")
  privacyOverlays         PrivacyOverlay[]         @relation("PrivacyOverlayActor")
  productAnalyticsConsent ProductAnalyticsConsent?

  @@unique([provider, providerSubject])
}

model ProductAnalyticsConsent {
  appUserId     String                        @id
  status        ProductAnalyticsConsentStatus
  policyVersion String
  grantedAt     DateTime?
  withdrawnAt   DateTime?
  expiresAt     DateTime?
  updatedAt     DateTime                      @updatedAt

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model ExternalDataSource {
  id                  String                   @id @default(cuid())
  externalId          String                   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String
  providerKey         String
  status              ExternalDataSourceStatus @default(DISABLED)
  approvalReference   String?
  termsVersion        String?
  attribution         String?
  cadenceSeconds      Int
  backfillDays        Int
  checkpoint          Json?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastFailureCode     String?
  consecutiveFailures Int                      @default(0)
  nextAttemptAt       DateTime?
  quotaRemaining      Int?
  quotaResetAt        DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  account     Account                       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  runs        ExternalIngestionRun[]
  records     ExternalProviderRecord[]
  quarantines ExternalIngestionQuarantine[]

  @@unique([accountId, id])
  @@unique([accountId, externalId])
  @@unique([accountId, providerKey])
  @@index([status, lastSuccessAt])
}

model ExternalIngestionRun {
  id               String                     @id @default(cuid())
  accountId        String
  sourceId         String
  runKey           String
  mode             String
  status           ExternalIngestionRunStatus @default(RUNNING)
  windowStartedAt  DateTime
  windowEndedAt    DateTime
  checkpointBefore Json?
  checkpointAfter  Json?
  attemptCount     Int                        @default(1)
  pageCount        Int                        @default(0)
  recordCount      Int                        @default(0)
  publishedCount   Int                        @default(0)
  quarantinedCount Int                        @default(0)
  failureCode      String?
  startedAt        DateTime                   @default(now())
  completedAt      DateTime?

  account Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  source  ExternalDataSource       @relation(fields: [accountId, sourceId], references: [accountId, id], onDelete: Restrict)
  records ExternalProviderRecord[]

  @@unique([accountId, id])
  @@unique([sourceId, runKey])
  @@index([sourceId, status, startedAt])
}

model ExternalProviderRecord {
  id                  String                       @id @default(cuid())
  externalId          String                       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String
  sourceId            String
  runId               String
  recordType          String
  providerRecordId    String
  providerVersion     String
  payloadVersion      Int
  payloadDigest       String
  normalizedPayload   Json
  status              ExternalProviderRecordStatus
  canonicalType       String?
  canonicalExternalId String?                      @db.Uuid
  correctionOfId      String?
  retrievedAt         DateTime
  effectiveAt         DateTime?
  createdAt           DateTime                     @default(now())

  account      Account                      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  source       ExternalDataSource           @relation(fields: [accountId, sourceId], references: [accountId, id], onDelete: Restrict)
  run          ExternalIngestionRun         @relation(fields: [accountId, runId], references: [accountId, id], onDelete: Restrict)
  correctionOf ExternalProviderRecord?      @relation("ExternalRecordCorrection", fields: [accountId, correctionOfId], references: [accountId, id], onDelete: Restrict)
  corrections  ExternalProviderRecord[]     @relation("ExternalRecordCorrection")
  quarantine   ExternalIngestionQuarantine?

  @@unique([accountId, id])
  @@unique([sourceId, recordType, providerRecordId, providerVersion])
  @@index([accountId, recordType, status, effectiveAt])
  @@index([sourceId, providerRecordId, retrievedAt])
}

model ExternalIngestionQuarantine {
  id              String                   @id @default(cuid())
  accountId       String
  sourceId        String
  recordId        String                   @unique
  status          ExternalQuarantineStatus @default(OPEN)
  diagnosticCodes String[]
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  account Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  source  ExternalDataSource     @relation(fields: [accountId, sourceId], references: [accountId, id], onDelete: Restrict)
  record  ExternalProviderRecord @relation(fields: [accountId, recordId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([accountId, recordId])
  @@index([accountId, status, createdAt])
}

model AccountMembership {
  id          String           @id @default(cuid())
  accountId   String
  userId      String
  status      MembershipStatus @default(INVITED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  activatedAt DateTime?
  disabledAt  DateTime?
  removedAt   DateTime?

  account            Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user               AppUser                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments    MembershipRoleAssignment[]
  capabilityGrants   CapabilityGrant[]
  acceptedInvitation MembershipInvitation?

  @@unique([accountId, id])
  @@index([userId, status])
}

model MembershipInvitation {
  id                   String           @id @default(cuid())
  accountId            String
  intendedUserId       String?
  invitedByUserId      String
  deliveryContact      String?
  tokenVerifier        String           @unique
  authoritySnapshot    Json
  status               InvitationStatus @default(PENDING)
  expiresAt            DateTime
  terminalAt           DateTime?
  acceptedMembershipId String?
  supersedesId         String?
  createdAt            DateTime         @default(now())

  account            Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  intendedUser       AppUser?               @relation("InvitationRecipient", fields: [intendedUserId], references: [id], onDelete: Restrict)
  invitedByUser      AppUser                @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedMembership AccountMembership?     @relation(fields: [accountId, acceptedMembershipId], references: [accountId, id], onDelete: Restrict)
  supersedes         MembershipInvitation?  @relation("InvitationSupersession", fields: [accountId, supersedesId], references: [accountId, id], onDelete: Restrict)
  supersededBy       MembershipInvitation[] @relation("InvitationSupersession")

  @@unique([accountId, id])
  @@unique([accountId, acceptedMembershipId])
  @@index([accountId, status, expiresAt])
  @@index([intendedUserId, status])
}

model MembershipRoleAssignment {
  id           String             @id @default(cuid())
  accountId    String
  membershipId String
  role         MembershipRole
  scope        AuthorizationScope @default(ACCOUNT)
  teamId       String?
  seasonId     String?
  gameId       String?
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?

  membership AccountMembership @relation(fields: [accountId, membershipId], references: [accountId, id], onDelete: Restrict)
  team       Team?             @relation("RoleAssignmentTeam", fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  season     Season?           @relation("RoleAssignmentSeason", fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  game       Game?             @relation("RoleAssignmentGame", fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@index([accountId, membershipId, revokedAt])
  @@index([accountId, scope, teamId, seasonId, gameId])
}

model CapabilityGrant {
  id           String             @id @default(cuid())
  accountId    String
  membershipId String
  capability   String
  scope        AuthorizationScope @default(ACCOUNT)
  teamId       String?
  seasonId     String?
  gameId       String?
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?

  membership AccountMembership @relation(fields: [accountId, membershipId], references: [accountId, id], onDelete: Restrict)
  team       Team?             @relation("CapabilityGrantTeam", fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  season     Season?           @relation("CapabilityGrantSeason", fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  game       Game?             @relation("CapabilityGrantGame", fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@index([accountId, membershipId, revokedAt])
}

model Team {
  id          String     @id @default(cuid())
  externalId  String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String
  displayName String
  color       String?
  status      TeamStatus @default(ACTIVE)
  revision    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?

  account          Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  teamSeasons      TeamSeason[]
  roleAssignments  MembershipRoleAssignment[] @relation("RoleAssignmentTeam")
  capabilityGrants CapabilityGrant[]          @relation("CapabilityGrantTeam")

  @@unique([accountId, id])
  @@unique([accountId, externalId])
  @@index([accountId, status])
  @@index([accountId, displayName, id])
}

model Season {
  id          String       @id @default(cuid())
  externalId  String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String
  displayName String
  startsOn    DateTime?    @db.Date
  endsOn      DateTime?    @db.Date
  status      SeasonStatus @default(DRAFT)
  revision    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  account               Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  teamSeasons           TeamSeason[]
  games                 Game[]
  roleAssignments       MembershipRoleAssignment[] @relation("RoleAssignmentSeason")
  capabilityGrants      CapabilityGrant[]          @relation("CapabilityGrantSeason")
  projectionCheckpoints ProjectionCheckpoint[]

  @@unique([accountId, id])
  @@unique([accountId, externalId])
  @@index([accountId, status])
  @@index([accountId, displayName, id])
}

model TeamSeason {
  id         String    @id @default(cuid())
  accountId  String
  teamId     String
  seasonId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  revision   Int       @default(0)

  account       Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  team          Team               @relation(fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  season        Season             @relation(fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  rosterEntries RosterEntry[]
  games         Game[]
  gameTeams     GameTeamSnapshot[]

  @@unique([accountId, teamId, seasonId])
  @@unique([accountId, id])
  @@unique([accountId, seasonId, id])
  @@unique([accountId, teamId, id])
  @@index([accountId, teamId])
  @@index([accountId, seasonId])
}

model Player {
  id           String        @id @default(cuid())
  externalId   String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String
  displayName  String
  battingSide  BattingSide?
  throwingHand ThrowingHand?
  revision     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rosterEntries        RosterEntry[]
  lineupSlots          LineupSlotSnapshot[]
  privacyOverlayFields PrivacyOverlayField[]

  @@unique([accountId, id])
  @@unique([accountId, externalId])
  @@index([accountId, archivedAt])
  @@index([accountId, displayName, id])
}

model RosterEntry {
  id              String            @id @default(cuid())
  accountId       String
  playerId        String
  teamSeasonId    String
  jerseyNumber    String?
  primaryPosition BaseballPosition?
  status          RosterStatus      @default(ACTIVE)
  startsAt        DateTime          @default(now())
  endsAt          DateTime?
  revision        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  archivedAt      DateTime?

  account     Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  player      Player               @relation(fields: [accountId, playerId], references: [accountId, id], onDelete: Restrict)
  teamSeason  TeamSeason           @relation(fields: [accountId, teamSeasonId], references: [accountId, id], onDelete: Restrict)
  lineupSlots LineupSlotSnapshot[]

  @@unique([accountId, id])
  @@index([accountId, teamSeasonId, status])
  @@index([accountId, teamSeasonId, startsAt, id])
  @@index([accountId, playerId, startsAt, id])
}

model RulesetVersion {
  id            String        @id @default(cuid())
  accountId     String
  name          String
  version       Int
  configuration Json
  status        RulesetStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  archivedAt    DateTime?

  account        Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  setupSnapshots GameSetupSnapshot[]
  sourceEvents   SourceEvent[]

  @@unique([accountId, name, version])
  @@unique([accountId, id])
  @@index([accountId, status])
}

model Game {
  id                   String            @id @default(cuid())
  externalId           String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            String
  seasonId             String
  teamSeasonId         String
  status               GameStatus        @default(DRAFT)
  revision             Int               @default(0)
  setupRevision        Int               @default(0)
  readySetupSnapshotId String?
  scheduledAt          DateTime?
  location             String?
  weatherCondition     WeatherCondition?
  temperatureF         Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  archivedAt           DateTime?

  account               Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  season                Season                     @relation(fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  teamSeason            TeamSeason                 @relation(fields: [accountId, seasonId, teamSeasonId], references: [accountId, seasonId, id], onDelete: Restrict)
  readySetupSnapshot    GameSetupSnapshot?         @relation("ReadyGameSetup", fields: [accountId, id, readySetupSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  teamSnapshots         GameTeamSnapshot[]
  setupSnapshots        GameSetupSnapshot[]
  playTransactions      PlayTransaction[]
  sourceEvents          SourceEvent[]
  projectionCheckpoints ProjectionCheckpoint[]
  roleAssignments       MembershipRoleAssignment[] @relation("RoleAssignmentGame")
  capabilityGrants      CapabilityGrant[]          @relation("CapabilityGrantGame")
  calendarEventLinks    CalendarEventLink[]

  @@unique([accountId, id])
  @@unique([accountId, externalId])
  @@unique([accountId, id, readySetupSnapshotId])
  @@index([accountId, seasonId, status])
  @@index([accountId, teamSeasonId, scheduledAt])
}

model CalendarConnection {
  id                  String                   @id @default(cuid())
  externalId          String                   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String
  provider            CalendarProvider
  providerCalendarId  String
  credentialReference String
  timeZone            String
  detailLevel         CalendarDetailLevel      @default(PRIVATE)
  status              CalendarConnectionStatus @default(ACTIVE)
  syncLeaseOwner      String?
  syncLeaseExpiresAt  DateTime?
  lastSyncAt          DateTime?
  lastFailureAt       DateTime?
  lastFailureCode     String?
  disconnectedAt      DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  account Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  events  CalendarEventLink[]

  @@unique([accountId, id])
  @@unique([accountId, provider, providerCalendarId])
  @@index([status, syncLeaseExpiresAt])
  @@index([accountId, status])
}

model CalendarEventLink {
  id                String                  @id @default(cuid())
  accountId         String
  connectionId      String
  gameId            String
  providerEventId   String
  providerVersion   String?
  sourceFingerprint String?
  status            CalendarEventSyncStatus @default(PENDING)
  attemptCount      Int                     @default(0)
  lastFailureCode   String?
  lastAttemptAt     DateTime?
  lastSyncedAt      DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  connection CalendarConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Restrict)
  game       Game               @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([connectionId, gameId])
  @@unique([connectionId, providerEventId])
  @@index([accountId, status, updatedAt])
  @@index([accountId, gameId])
}

model GameTeamSnapshot {
  id              String   @id @default(cuid())
  accountId       String
  gameId          String
  setupSnapshotId String
  side            GameSide
  teamId          String?
  teamSeasonId    String?
  displayName     String
  isAccountTeam   Boolean
  createdAt       DateTime @default(now())

  account       Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game          Game                 @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  setupSnapshot GameSetupSnapshot    @relation(fields: [accountId, gameId, setupSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  teamSeason    TeamSeason?          @relation(fields: [accountId, teamId, teamSeasonId], references: [accountId, teamId, id], onDelete: Restrict)
  lineupSlots   LineupSlotSnapshot[]

  @@unique([accountId, id])
  @@unique([accountId, gameId, setupSnapshotId, id])
  @@unique([setupSnapshotId, side])
  @@index([accountId, teamId])
  @@index([accountId, teamSeasonId])
}

model GameSetupSnapshot {
  id                 String            @id @default(cuid())
  accountId          String
  gameId             String
  setupRevision      Int
  rulesetVersionId   String
  scheduledAt        DateTime?
  location           String?
  weatherCondition   WeatherCondition?
  temperatureF       Int?
  scheduledInnings   Int
  createdByActorId   String?
  clientSubmissionId String?
  payloadHash        String?
  acceptedAt         DateTime          @default(now())

  account          Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game             Game                 @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  readyForGame     Game?                @relation("ReadyGameSetup")
  rulesetVersion   RulesetVersion       @relation(fields: [accountId, rulesetVersionId], references: [accountId, id], onDelete: Restrict)
  lineupSlots      LineupSlotSnapshot[]
  teamSnapshots    GameTeamSnapshot[]
  playTransactions PlayTransaction[]
  sourceEvents     SourceEvent[]

  @@unique([accountId, id])
  @@unique([gameId, setupRevision])
  @@unique([accountId, gameId, id])
  @@unique([accountId, gameId, createdByActorId, clientSubmissionId], map: "GameSetupSnapshot_setup_submission_key")
  @@index([accountId, rulesetVersionId])
}

model LineupSlotSnapshot {
  id                 String            @id @default(cuid())
  accountId          String
  gameId             String
  setupSnapshotId    String
  gameTeamSnapshotId String
  playerId           String?
  rosterEntryId      String?
  displayName        String
  jerseyNumber       String?
  battingOrder       Int?
  defensivePosition  BaseballPosition?
  isStartingPitcher  Boolean           @default(false)
  createdAt          DateTime          @default(now())

  account          Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  setupSnapshot    GameSetupSnapshot     @relation(fields: [accountId, gameId, setupSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  gameTeamSnapshot GameTeamSnapshot      @relation(fields: [accountId, gameId, setupSnapshotId, gameTeamSnapshotId], references: [accountId, gameId, setupSnapshotId, id], onDelete: Restrict)
  player           Player?               @relation(fields: [accountId, playerId], references: [accountId, id], onDelete: Restrict)
  rosterEntry      RosterEntry?          @relation(fields: [accountId, rosterEntryId], references: [accountId, id], onDelete: Restrict)
  privacyOverlays  PrivacyOverlayField[]

  @@unique([accountId, id])
  @@unique([setupSnapshotId, gameTeamSnapshotId, battingOrder])
  @@index([accountId, playerId])
  @@index([accountId, rosterEntryId])
}

model PlayTransaction {
  id                 String    @id @default(cuid())
  accountId          String
  gameId             String
  setupSnapshotId    String
  acceptedRevision   Int
  expectedRevision   Int
  clientSubmissionId String
  payloadHash        String
  preStateHash       String
  postStateHash      String
  actorKind          ActorKind
  actorId            String
  actorUserId        String?
  acceptedAt         DateTime  @default(now())

  account       Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game          Game              @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  setupSnapshot GameSetupSnapshot @relation(fields: [accountId, gameId, setupSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  actorUser     AppUser?          @relation("PlayTransactionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  sourceEvents  SourceEvent[]

  @@unique([accountId, id])
  @@unique([accountId, gameId, id])
  @@unique([accountId, gameId, setupSnapshotId, id])
  @@unique([gameId, acceptedRevision])
  @@unique([accountId, gameId, actorId, clientSubmissionId])
  @@index([accountId, gameId, acceptedAt])
}

model SourceEvent {
  id                 String    @id @default(cuid())
  accountId          String
  gameId             String
  setupSnapshotId    String
  playTransactionId  String?
  sequence           Int
  componentOrder     Int?
  parentEventId      String?
  eventType          String
  schemaVersion      Int
  rulesetVersionId   String
  clientSubmissionId String
  expectedRevision   Int
  acceptedRevision   Int
  payloadHash        String
  payload            Json
  preStateHash       String?
  postStateHash      String?
  actorKind          ActorKind
  actorId            String
  actorUserId        String?
  recordedAt         DateTime  @default(now())

  account                Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game                   Game              @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  setupSnapshot          GameSetupSnapshot @relation(fields: [accountId, gameId, setupSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  playTransaction        PlayTransaction?  @relation(fields: [accountId, gameId, setupSnapshotId, playTransactionId], references: [accountId, gameId, setupSnapshotId, id], onDelete: Restrict, map: "SourceEvent_setup_playTransaction_fkey")
  rulesetVersion         RulesetVersion    @relation(fields: [accountId, rulesetVersionId], references: [accountId, id], onDelete: Restrict)
  actorUser              AppUser?          @relation("SourceEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  parentEvent            SourceEvent?      @relation("EventParent", fields: [accountId, gameId, parentEventId], references: [accountId, gameId, id], onDelete: Restrict)
  childEvents            SourceEvent[]     @relation("EventParent")
  correctionsAuthored    EventCorrection[] @relation("CorrectionEvent")
  correctionTargets      EventCorrection[] @relation("CorrectionTarget")
  correctionReplacements EventCorrection[] @relation("CorrectionReplacement")

  @@unique([accountId, id])
  @@unique([accountId, gameId, id])
  @@unique([gameId, sequence])
  @@unique([playTransactionId, componentOrder])
  @@index([accountId, gameId, setupSnapshotId, sequence])
  @@index([accountId, gameId, recordedAt])
  @@index([accountId, rulesetVersionId])
  @@index([accountId, gameId, actorId, clientSubmissionId])
}

model EventCorrection {
  id                   String           @id @default(cuid())
  accountId            String
  gameId               String
  correctionEventId    String
  targetEventId        String
  replacementEventId   String?
  replacementPayloadId String?
  policy               CorrectionPolicy
  createdAt            DateTime         @default(now())

  account          Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  correctionEvent  SourceEvent  @relation("CorrectionEvent", fields: [accountId, gameId, correctionEventId], references: [accountId, gameId, id], onDelete: Restrict)
  targetEvent      SourceEvent  @relation("CorrectionTarget", fields: [accountId, gameId, targetEventId], references: [accountId, gameId, id], onDelete: Restrict)
  replacementEvent SourceEvent? @relation("CorrectionReplacement", fields: [accountId, gameId, replacementEventId], references: [accountId, gameId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([accountId, gameId, correctionEventId, targetEventId])
  @@index([accountId, gameId, targetEventId])
}

model ProjectionCheckpoint {
  id                     String           @id @default(cuid())
  accountId              String
  scope                  ProjectionScope
  gameId                 String?
  seasonId               String?
  sourceRevision         Int
  privacyOverlayRevision Int              @default(0)
  derivationVersion      Int
  status                 ProjectionStatus @default(PENDING)
  failureCode            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game    Game?   @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  season  Season? @relation(fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([accountId, gameId, sourceRevision, privacyOverlayRevision, derivationVersion])
  @@unique([accountId, seasonId, sourceRevision, privacyOverlayRevision, derivationVersion])
  @@index([accountId, scope, status])
}

model SecurityAuditRecord {
  id            String       @id @default(cuid())
  scope         AuditScope
  accountId     String?
  actorKind     ActorKind
  actorId       String
  actorUserId   String?
  action        String
  capability    String?
  targetType    String
  targetId      String
  outcome       AuditOutcome
  reasonCode    String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  account   Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actorUser AppUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([accountId, targetType, targetId])
  @@index([correlationId])
}

model PrivacyOverlay {
  id             String   @id @default(cuid())
  accountId      String
  effectiveOrder Int
  reasonCode     String
  actorId        String
  actorUserId    String?
  correlationId  String?
  createdAt      DateTime @default(now())

  account   Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actorUser AppUser?              @relation("PrivacyOverlayActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  fields    PrivacyOverlayField[]

  @@unique([accountId, id])
  @@unique([accountId, effectiveOrder])
}

model PrivacyOverlayField {
  id                   String              @id @default(cuid())
  accountId            String
  privacyOverlayId     String
  playerId             String?
  lineupSlotSnapshotId String?
  field                PrivacyDisplayField
  replacementValue     String
  createdAt            DateTime            @default(now())

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  privacyOverlay     PrivacyOverlay      @relation(fields: [accountId, privacyOverlayId], references: [accountId, id], onDelete: Restrict)
  player             Player?             @relation(fields: [accountId, playerId], references: [accountId, id], onDelete: Restrict)
  lineupSlotSnapshot LineupSlotSnapshot? @relation(fields: [accountId, lineupSlotSnapshotId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([privacyOverlayId, playerId, lineupSlotSnapshotId, field])
  @@index([accountId, playerId])
  @@index([accountId, lineupSlotSnapshotId])
}

model DataExportArtifact {
  id                 String                   @id @default(cuid())
  accountId          String
  requestedByActorId String
  clientRequestId    String
  status             DataExportArtifactStatus @default(AVAILABLE)
  tokenVerifier      String?
  expiresAt          DateTime
  downloadedAt       DateTime?
  cancelledAt        DateTime?
  revokedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, requestedByActorId, clientRequestId])
  @@unique([accountId, id])
  @@index([accountId, status, expiresAt])
}

model PrivacyLifecycleRequest {
  id                 String                 @id @default(cuid())
  accountId          String
  target             PrivacyLifecycleTarget
  targetId           String
  requestedByActorId String
  clientRequestId    String
  status             PrivacyLifecycleStatus @default(REQUESTED)
  reasonCode         String
  scheduledFor       DateTime
  confirmedAt        DateTime
  blockedAt          DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  account Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  holds   PrivacyHold[]

  @@unique([accountId, requestedByActorId, clientRequestId])
  @@unique([accountId, id])
  @@index([accountId, target, targetId, status])
  @@index([status, scheduledFor])
}

model PrivacyHold {
  id                 String            @id @default(cuid())
  accountId          String
  lifecycleRequestId String?
  status             PrivacyHoldStatus @default(ACTIVE)
  reasonCode         String
  requestedByActorId String
  expiresAt          DateTime?
  releasedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  account          Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lifecycleRequest PrivacyLifecycleRequest? @relation(fields: [accountId, lifecycleRequestId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@index([accountId, status, expiresAt])
  @@index([accountId, lifecycleRequestId, status])
}

model RateLimitCounter {
  id              String         @id @default(cuid())
  accountId       String
  scope           RateLimitScope
  actorKind       ActorKind
  subjectKey      String
  endpointClass   String
  policyVersion   String
  windowStartedAt DateTime
  windowSeconds   Int
  limit           Int
  used            Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, scope, actorKind, subjectKey, endpointClass, policyVersion, windowStartedAt])
  @@index([accountId, endpointClass, windowStartedAt])
  @@index([updatedAt])
}

model RateLimitCharge {
  id            String    @id @default(cuid())
  accountId     String
  actorKind     ActorKind
  actorId       String
  endpointClass String
  operationKey  String
  fingerprint   String
  cost          Int
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, actorKind, actorId, endpointClass, operationKey])
  @@index([expiresAt])
}

model RateLimitOverride {
  id               String                  @id @default(cuid())
  accountId        String
  endpointClass    String
  actorKind        ActorKind?
  actorId          String?
  actorLimit       Int
  accountLimit     Int
  status           RateLimitOverrideStatus @default(ACTIVE)
  reasonCode       String
  grantedByActorId String
  revokedByActorId String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, id])
  @@index([accountId, endpointClass, status, expiresAt])
  @@index([accountId, actorKind, actorId, endpointClass, status, expiresAt])
}

model WebhookEndpoint {
  id               String                @id @default(cuid())
  externalId       String                @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId        String
  url              String
  status           WebhookEndpointStatus @default(PENDING_VERIFICATION)
  subscribedEvents WebhookEventName[]
  secretVersion    Int                   @default(1)
  verifiedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([accountId, id])
  @@unique([accountId, externalId])
  @@unique([accountId, url])
  @@index([accountId, status])
}

model WebhookEvent {
  id               String           @id @default(cuid())
  externalId       String           @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId        String
  sequence         BigInt           @default(autoincrement())
  eventName        WebhookEventName
  payloadVersion   Int              @default(1)
  deduplicationKey String
  payload          Json
  occurredAt       DateTime
  retentionUntil   DateTime
  createdAt        DateTime         @default(now())

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([accountId, id])
  @@unique([accountId, deduplicationKey])
  @@unique([accountId, sequence])
  @@index([accountId, eventName, occurredAt])
  @@index([retentionUntil])
}

model WebhookDelivery {
  id                  String                @id @default(cuid())
  externalId          String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String
  endpointId          String
  eventId             String
  replayNumber        Int                   @default(0)
  secretVersion       Int
  status              WebhookDeliveryStatus @default(PENDING)
  attemptCount        Int                   @default(0)
  nextAttemptAt       DateTime              @default(now())
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  lastFailureCode     String?
  deliveredAt         DateTime?
  deadLetteredAt      DateTime?
  cancelledAt         DateTime?
  replayRequestedAt   DateTime?
  replayRequestedById String?
  retentionUntil      DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  account  Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  endpoint WebhookEndpoint          @relation(fields: [accountId, endpointId], references: [accountId, id], onDelete: Restrict)
  event    WebhookEvent             @relation(fields: [accountId, eventId], references: [accountId, id], onDelete: Restrict)
  attempts WebhookDeliveryAttempt[]

  @@unique([accountId, id])
  @@unique([endpointId, eventId, replayNumber])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([accountId, endpointId, status, createdAt])
  @@index([retentionUntil])
}

model WebhookDeliveryAttempt {
  id             String                @id @default(cuid())
  accountId      String
  deliveryId     String
  workerId       String
  attemptNumber  Int
  outcome        WebhookAttemptOutcome
  responseStatus Int?
  failureCode    String?
  durationMs     Int
  startedAt      DateTime
  completedAt    DateTime

  account  Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  delivery WebhookDelivery @relation(fields: [accountId, deliveryId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([deliveryId, attemptNumber])
  @@index([accountId, completedAt])
}
