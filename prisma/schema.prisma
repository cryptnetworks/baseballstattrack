generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
  PENDING_DELETION
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
  REMOVED
}

enum MembershipRole {
  OWNER
  ADMINISTRATOR
  COACH_MANAGER
  SCOREKEEPER
  VIEWER
}

enum AuthorizationScope {
  ACCOUNT
  TEAM
  SEASON
  GAME
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RosterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GameStatus {
  DRAFT
  READY
  IN_PROGRESS
  SUSPENDED
  COMPLETED
  VERIFIED
  CORRECTED
  ABANDONED
  CANCELLED
}

enum GameSide {
  HOME
  AWAY
}

enum BaseballPosition {
  PITCHER
  CATCHER
  FIRST_BASE
  SECOND_BASE
  THIRD_BASE
  SHORTSTOP
  LEFT_FIELD
  CENTER_FIELD
  RIGHT_FIELD
  DESIGNATED_HITTER
  EXTRA_HITTER
}

enum RulesetStatus {
  ACTIVE
  ARCHIVED
}

enum ActorKind {
  USER
  SERVICE
  SYSTEM
}

enum ProjectionScope {
  GAME
  SEASON
}

enum ProjectionStatus {
  PENDING
  BUILDING
  CURRENT
  FAILED
  STALE
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

enum PrivacyDisplayField {
  PLAYER_DISPLAY_NAME
}

model Account {
  id          String        @id @default(cuid())
  slug        String        @unique
  displayName String
  status      AccountStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  memberships          AccountMembership[]
  teams                Team[]
  seasons              Season[]
  teamSeasons          TeamSeason[]
  players              Player[]
  rosterEntries        RosterEntry[]
  rulesetVersions      RulesetVersion[]
  games                Game[]
  gameTeams            GameTeamSnapshot[]
  setupSnapshots       GameSetupSnapshot[]
  lineupSlots          LineupSlotSnapshot[]
  playTransactions     PlayTransaction[]
  sourceEvents         SourceEvent[]
  eventSupersessions   EventSupersession[]
  projectionCheckpoints ProjectionCheckpoint[]
  securityAuditRecords SecurityAuditRecord[]
  privacyOverlays      PrivacyOverlay[]
  privacyOverlayFields PrivacyOverlayField[]
}

model AppUser {
  id              String              @id @default(cuid())
  providerSubject String              @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  detachedAt      DateTime?

  memberships       AccountMembership[]
  recordedPlays     PlayTransaction[]  @relation("PlayTransactionActor")
  recordedEvents    SourceEvent[]      @relation("SourceEventActor")
  auditRecords      SecurityAuditRecord[] @relation("AuditActor")
  privacyOverlays   PrivacyOverlay[]   @relation("PrivacyOverlayActor")
}

model AccountMembership {
  id        String           @id @default(cuid())
  accountId String
  userId    String
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  activatedAt DateTime?
  disabledAt  DateTime?
  removedAt   DateTime?

  account          Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user             AppUser                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments  MembershipRoleAssignment[]
  capabilityGrants CapabilityGrant[]

  @@unique([accountId, userId])
  @@unique([accountId, id])
  @@index([userId, status])
}

model MembershipRoleAssignment {
  id           String             @id @default(cuid())
  accountId    String
  membershipId String
  role         MembershipRole
  scope        AuthorizationScope @default(ACCOUNT)
  teamId       String?
  seasonId     String?
  gameId       String?
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?

  membership AccountMembership @relation(fields: [accountId, membershipId], references: [accountId, id], onDelete: Restrict)
  team       Team?             @relation("RoleAssignmentTeam", fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  season     Season?           @relation("RoleAssignmentSeason", fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  game       Game?             @relation("RoleAssignmentGame", fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@index([accountId, membershipId, revokedAt])
  @@index([accountId, scope, teamId, seasonId, gameId])
}

model CapabilityGrant {
  id           String             @id @default(cuid())
  accountId    String
  membershipId String
  capability   String
  scope        AuthorizationScope @default(ACCOUNT)
  teamId       String?
  seasonId     String?
  gameId       String?
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?

  membership AccountMembership @relation(fields: [accountId, membershipId], references: [accountId, id], onDelete: Restrict)
  team       Team?             @relation("CapabilityGrantTeam", fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  season     Season?           @relation("CapabilityGrantSeason", fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  game       Game?             @relation("CapabilityGrantGame", fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, membershipId, capability, scope, teamId, seasonId, gameId])
  @@unique([accountId, id])
  @@index([accountId, membershipId, revokedAt])
}

model Team {
  id          String     @id @default(cuid())
  accountId   String
  displayName String
  color       String?
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?

  account                Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  teamSeasons            TeamSeason[]
  roleAssignments        MembershipRoleAssignment[] @relation("RoleAssignmentTeam")
  capabilityGrants       CapabilityGrant[]          @relation("CapabilityGrantTeam")
  gameTeamSnapshots      GameTeamSnapshot[]

  @@unique([accountId, id])
  @@index([accountId, status])
}

model Season {
  id          String       @id @default(cuid())
  accountId   String
  displayName String
  startsOn    DateTime?    @db.Date
  endsOn      DateTime?    @db.Date
  status      SeasonStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  account             Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  teamSeasons         TeamSeason[]
  games               Game[]
  roleAssignments     MembershipRoleAssignment[] @relation("RoleAssignmentSeason")
  capabilityGrants    CapabilityGrant[]          @relation("CapabilityGrantSeason")
  projectionCheckpoints ProjectionCheckpoint[]

  @@unique([accountId, id])
  @@index([accountId, status])
}

model TeamSeason {
  id        String   @id @default(cuid())
  accountId String
  teamId    String
  seasonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  team          Team          @relation(fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  season        Season        @relation(fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  rosterEntries RosterEntry[]
  games         Game[]
  gameTeams     GameTeamSnapshot[]

  @@unique([accountId, teamId, seasonId])
  @@unique([accountId, id])
  @@unique([accountId, seasonId, id])
  @@index([accountId, teamId])
  @@index([accountId, seasonId])
}

model Player {
  id          String   @id @default(cuid())
  accountId   String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rosterEntries        RosterEntry[]
  lineupSlots          LineupSlotSnapshot[]
  privacyOverlayFields PrivacyOverlayField[]

  @@unique([accountId, id])
  @@index([accountId, archivedAt])
}

model RosterEntry {
  id           String       @id @default(cuid())
  accountId    String
  playerId     String
  teamSeasonId String
  jerseyNumber String?
  status       RosterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  player     Player     @relation(fields: [accountId, playerId], references: [accountId, id], onDelete: Restrict)
  teamSeason TeamSeason @relation(fields: [accountId, teamSeasonId], references: [accountId, id], onDelete: Restrict)
  lineupSlots LineupSlotSnapshot[]

  @@unique([accountId, teamSeasonId, playerId])
  @@unique([accountId, id])
  @@index([accountId, teamSeasonId, status])
}

model RulesetVersion {
  id              String        @id @default(cuid())
  accountId       String
  name            String
  version         Int
  configuration   Json
  status          RulesetStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  archivedAt      DateTime?

  account          Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  setupSnapshots   GameSetupSnapshot[]
  sourceEvents     SourceEvent[]

  @@unique([accountId, name, version])
  @@unique([accountId, id])
  @@index([accountId, status])
}

model Game {
  id           String     @id @default(cuid())
  accountId    String
  seasonId     String
  teamSeasonId String
  status       GameStatus @default(DRAFT)
  revision     Int        @default(0)
  scheduledAt  DateTime?
  location     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  archivedAt   DateTime?

  account               Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  season                Season                     @relation(fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)
  teamSeason            TeamSeason                 @relation(fields: [accountId, seasonId, teamSeasonId], references: [accountId, seasonId, id], onDelete: Restrict)
  teamSnapshots         GameTeamSnapshot[]
  setupSnapshots        GameSetupSnapshot[]
  playTransactions      PlayTransaction[]
  sourceEvents          SourceEvent[]
  projectionCheckpoints ProjectionCheckpoint[]
  roleAssignments       MembershipRoleAssignment[] @relation("RoleAssignmentGame")
  capabilityGrants      CapabilityGrant[]          @relation("CapabilityGrantGame")

  @@unique([accountId, id])
  @@index([accountId, seasonId, status])
  @@index([accountId, teamSeasonId, scheduledAt])
}

model GameTeamSnapshot {
  id           String   @id @default(cuid())
  accountId    String
  gameId       String
  side         GameSide
  teamId       String?
  teamSeasonId String?
  displayName  String
  isAccountTeam Boolean
  createdAt    DateTime @default(now())

  account         Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game            Game                  @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  team            Team?                 @relation(fields: [accountId, teamId], references: [accountId, id], onDelete: Restrict)
  teamSeason      TeamSeason?           @relation(fields: [accountId, teamSeasonId], references: [accountId, id], onDelete: Restrict)
  lineupSlots     LineupSlotSnapshot[]

  @@unique([accountId, id])
  @@unique([accountId, gameId, id])
  @@unique([gameId, side])
  @@index([accountId, teamId])
  @@index([accountId, teamSeasonId])
}

model GameSetupSnapshot {
  id                String   @id @default(cuid())
  accountId         String
  gameId            String
  setupRevision     Int
  rulesetVersionId  String
  acceptedAt        DateTime @default(now())

  account        Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game           Game                @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  rulesetVersion RulesetVersion      @relation(fields: [accountId, rulesetVersionId], references: [accountId, id], onDelete: Restrict)
  lineupSlots    LineupSlotSnapshot[]

  @@unique([accountId, id])
  @@unique([gameId, setupRevision])
  @@unique([accountId, gameId, id])
  @@index([accountId, rulesetVersionId])
}

model LineupSlotSnapshot {
  id                 String            @id @default(cuid())
  accountId          String
  gameId             String
  setupSnapshotId    String
  gameTeamSnapshotId String
  playerId           String?
  rosterEntryId      String?
  displayName        String
  jerseyNumber       String?
  battingOrder       Int
  defensivePosition  BaseballPosition?
  isStartingPitcher  Boolean           @default(false)
  createdAt          DateTime          @default(now())

  account          Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  setupSnapshot    GameSetupSnapshot   @relation(fields: [accountId, gameId, setupSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  gameTeamSnapshot GameTeamSnapshot    @relation(fields: [accountId, gameId, gameTeamSnapshotId], references: [accountId, gameId, id], onDelete: Restrict)
  player           Player?             @relation(fields: [accountId, playerId], references: [accountId, id], onDelete: Restrict)
  rosterEntry      RosterEntry?        @relation(fields: [accountId, rosterEntryId], references: [accountId, id], onDelete: Restrict)
  privacyOverlays  PrivacyOverlayField[]

  @@unique([accountId, id])
  @@unique([setupSnapshotId, gameTeamSnapshotId, battingOrder])
  @@index([accountId, playerId])
  @@index([accountId, rosterEntryId])
}

model PlayTransaction {
  id                  String   @id @default(cuid())
  accountId           String
  gameId              String
  acceptedRevision    Int
  expectedRevision    Int
  clientSubmissionId  String
  payloadHash         String
  actorKind           ActorKind
  actorId             String
  actorUserId         String?
  acceptedAt          DateTime @default(now())

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game         Game         @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  actorUser    AppUser?     @relation("PlayTransactionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  sourceEvents SourceEvent[]

  @@unique([accountId, id])
  @@unique([accountId, gameId, id])
  @@unique([gameId, acceptedRevision])
  @@unique([accountId, gameId, actorId, clientSubmissionId])
  @@index([accountId, gameId, acceptedAt])
}

model SourceEvent {
  id                String   @id @default(cuid())
  accountId         String
  gameId            String
  playTransactionId String?
  sequence          Int
  componentOrder    Int?
  eventType         String
  schemaVersion     Int
  rulesetVersionId  String
  payload           Json
  preStateHash      String?
  postStateHash     String?
  actorKind         ActorKind
  actorId           String
  actorUserId       String?
  recordedAt        DateTime @default(now())

  account          Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game             Game               @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  playTransaction  PlayTransaction?   @relation(fields: [accountId, gameId, playTransactionId], references: [accountId, gameId, id], onDelete: Restrict)
  rulesetVersion   RulesetVersion     @relation(fields: [accountId, rulesetVersionId], references: [accountId, id], onDelete: Restrict)
  actorUser        AppUser?           @relation("SourceEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  supersedes       EventSupersession[] @relation("ReplacementEvent")
  supersededBy     EventSupersession[] @relation("SupersededEvent")

  @@unique([accountId, id])
  @@unique([accountId, gameId, id])
  @@unique([gameId, sequence])
  @@unique([playTransactionId, componentOrder])
  @@index([accountId, gameId, recordedAt])
  @@index([accountId, rulesetVersionId])
}

model EventSupersession {
  id                String   @id @default(cuid())
  accountId         String
  gameId            String
  supersededEventId String
  replacementEventId String
  createdAt         DateTime @default(now())

  account          Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  supersededEvent  SourceEvent @relation("SupersededEvent", fields: [accountId, gameId, supersededEventId], references: [accountId, gameId, id], onDelete: Restrict)
  replacementEvent SourceEvent @relation("ReplacementEvent", fields: [accountId, gameId, replacementEventId], references: [accountId, gameId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([accountId, gameId, supersededEventId])
  @@unique([accountId, gameId, replacementEventId, supersededEventId])
}

model ProjectionCheckpoint {
  id                    String           @id @default(cuid())
  accountId             String
  scope                 ProjectionScope
  gameId                String?
  seasonId              String?
  sourceRevision        Int
  privacyOverlayRevision Int             @default(0)
  derivationVersion     Int
  status                ProjectionStatus @default(PENDING)
  failureCode           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  game    Game?   @relation(fields: [accountId, gameId], references: [accountId, id], onDelete: Restrict)
  season  Season? @relation(fields: [accountId, seasonId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([accountId, gameId, sourceRevision, derivationVersion])
  @@unique([accountId, seasonId, sourceRevision, derivationVersion])
  @@index([accountId, scope, status])
}

model SecurityAuditRecord {
  id            String       @id @default(cuid())
  accountId     String
  actorKind     ActorKind
  actorId       String
  actorUserId   String?
  action        String
  capability    String?
  targetType    String
  targetId      String
  outcome       AuditOutcome
  reasonCode    String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actorUser AppUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([accountId, id])
  @@index([accountId, createdAt])
  @@index([accountId, targetType, targetId])
  @@index([correlationId])
}

model PrivacyOverlay {
  id             String               @id @default(cuid())
  accountId      String
  effectiveOrder Int
  reasonCode     String
  actorId        String
  actorUserId    String?
  correlationId  String?
  createdAt      DateTime             @default(now())

  account Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actorUser AppUser?            @relation("PrivacyOverlayActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  fields    PrivacyOverlayField[]

  @@unique([accountId, id])
  @@unique([accountId, effectiveOrder])
}

model PrivacyOverlayField {
  id                  String              @id @default(cuid())
  accountId           String
  privacyOverlayId    String
  playerId            String?
  lineupSlotSnapshotId String?
  field               PrivacyDisplayField
  replacementValue    String
  createdAt           DateTime            @default(now())

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  privacyOverlay     PrivacyOverlay      @relation(fields: [accountId, privacyOverlayId], references: [accountId, id], onDelete: Restrict)
  player             Player?             @relation(fields: [accountId, playerId], references: [accountId, id], onDelete: Restrict)
  lineupSlotSnapshot LineupSlotSnapshot? @relation(fields: [accountId, lineupSlotSnapshotId], references: [accountId, id], onDelete: Restrict)

  @@unique([accountId, id])
  @@unique([privacyOverlayId, playerId, lineupSlotSnapshotId, field])
  @@index([accountId, playerId])
  @@index([accountId, lineupSlotSnapshotId])
}
