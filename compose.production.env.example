# Copy this file outside the repository or to an ignored .env.production file,
# replace every placeholder, and restrict it to the deployment operator.

# All three images must use the same immutable source tag or digest in
# production. The moving latest tag is suitable only for initial evaluation.
APP_IMAGE=ghcr.io/cryptnetworks/baseballstattrack:latest
MIGRATION_IMAGE=ghcr.io/cryptnetworks/baseballstattrack-migration:latest
DISCORD_BOT_IMAGE=ghcr.io/cryptnetworks/baseballstattrack-discord-bot:latest
IMAGE_PULL_POLICY=always

# The app binds to loopback by default so a host reverse proxy can terminate
# TLS. Set APP_BIND_ADDRESS=0.0.0.0 only when the host firewall is intentional.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

POSTGRES_DB=baseballstattrack
POSTGRES_USER=baseballstattrack
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode reserved characters from POSTGRES_PASSWORD in these URLs.
DATABASE_URL=postgresql://baseballstattrack:replace-with-a-long-random-password@db:5432/baseballstattrack?schema=public
DIRECT_URL=postgresql://baseballstattrack:replace-with-a-long-random-password@db:5432/baseballstattrack?schema=public

NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-public-anonymous-key
SUPABASE_OAUTH_PROVIDER=google
WEBHOOK_SIGNING_MASTER_KEY=replace-with-at-least-32-base64url-encoded-bytes
WEBHOOK_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_INGESTION_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_DATA_PROVIDER_BASE_URL=https://licensed-provider.example/
EXTERNAL_DATA_PROVIDER_API_KEY=replace-with-managed-provider-api-key

DISCORD_TOKEN=replace-with-a-secret-from-the-discord-developer-portal
BST_API_TOKEN=replace-with-a-dedicated-report-view-access-token
BST_API_BASE_URL=https://app.example.com
BST_WEB_BASE_URL=https://app.example.com
DISCORD_TEAM_BINDINGS=[{"guildId":"123456789012345678","accountId":"00000000-0000-4000-8000-000000000001","teamId":"00000000-0000-4000-8000-000000000002","defaultSeasonId":"00000000-0000-4000-8000-000000000003","channelIds":["123456789012345679"],"roleIds":["123456789012345680"]}]
BST_API_TIMEOUT_SECONDS=8
