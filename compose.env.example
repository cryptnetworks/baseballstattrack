# Optional overrides for compose.yaml. Copy to .env.container; never put
# production credentials or real user data in this local-development file.

APP_ENV=local
APP_PORT=3000
DEV_PORT=3001

POSTGRES_DB=baseballstattrack
POSTGRES_USER=baseballstattrack
POSTGRES_PASSWORD=local-development-only
WEBHOOK_SIGNING_MASTER_KEY=replace-with-at-least-32-base64url-encoded-bytes
WEBHOOK_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_INGESTION_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_DATA_PROVIDER_BASE_URL=https://licensed-provider.example/
EXTERNAL_DATA_PROVIDER_API_KEY=replace-with-managed-provider-api-key

APP_IMAGE=baseballstattrack:local
MIGRATION_IMAGE=baseballstattrack-migration:local
DEV_IMAGE=baseballstattrack-development:local
VCS_REF=local
