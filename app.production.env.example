# Copy to a protected app.production.env file and replace every placeholder.
# This file is injected only into the application container.

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-public-anonymous-key
SUPABASE_OAUTH_PROVIDER=google

WEBHOOK_SIGNING_MASTER_KEY=replace-with-at-least-32-base64url-encoded-bytes
WEBHOOK_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_INGESTION_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_DATA_PROVIDER_BASE_URL=https://licensed-provider.example/
EXTERNAL_DATA_PROVIDER_API_KEY=replace-with-managed-provider-api-key

FEATURE_ICS_CALENDAR_ENABLED=true
ICS_FEED_SIGNING_KEY=replace-with-at-least-32-random-characters
ICS_FEED_DETAIL_LEVEL=private

FEATURE_EMAIL_NOTIFICATIONS_ENABLED=true
FEATURE_DISCORD_NOTIFICATIONS_ENABLED=true
NOTIFICATION_WORKER_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_EVENT_TOKEN=replace-with-a-different-32-character-token
NOTIFICATION_DESTINATIONS_JSON={"notifications/email/coach":{"channel":"EMAIL","destination":"coach@example.com"},"notifications/discord/team":{"channel":"DISCORD","destination":"123456789012345678"}}
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=notifications@example.com
NOTIFICATION_DISCORD_API_BASE_URL=https://discord.com/api/v10/
NOTIFICATION_DISCORD_BOT_TOKEN=replace-with-managed-notification-bot-token
