# Copy this file to .env.local for local development. Do not commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_OAUTH_PROVIDER=google
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
WEBHOOK_SIGNING_MASTER_KEY=replace-with-at-least-32-base64url-encoded-bytes
WEBHOOK_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_INGESTION_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_DATA_PROVIDER_BASE_URL=https://licensed-provider.example/
EXTERNAL_DATA_PROVIDER_API_KEY=replace-with-managed-provider-api-key
CALENDAR_SYNC_WORKER_TOKEN=replace-with-at-least-32-random-characters
CALENDAR_PROVIDER_TOKENS_JSON={"calendar/local":"replace-with-google-oauth-access-token"}
NOTIFICATION_WORKER_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_EVENT_TOKEN=replace-with-a-different-32-character-token
NOTIFICATION_DESTINATIONS_JSON={"notifications/email/local":{"channel":"EMAIL","destination":"coach@example.test"},"notifications/discord/local":{"channel":"DISCORD","destination":"123456789012345678"}}
NOTIFICATION_EMAIL_PROVIDER_URL=https://email-provider.example/v1/messages
NOTIFICATION_EMAIL_PROVIDER_TOKEN=replace-with-managed-email-provider-token
NOTIFICATION_DISCORD_API_BASE_URL=https://discord.com/api/v10/
NOTIFICATION_DISCORD_BOT_TOKEN=replace-with-managed-notification-bot-token
