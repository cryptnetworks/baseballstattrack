# Bootstrap and infrastructure reference for a direct application runtime.
# Application behavior is Account-scoped and managed at /settings/configuration;
# feature flags, notification behavior, provider URLs, and rate limits do not
# belong in this file. Use .env.local.example for local development and
# .env.production.example for the production application container.

# Required deployment identity (non-secret; deployment-owned).
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.example.com
PORT=3000
REQUIRED_DATABASE_MIGRATION=20260806010000_configuration_entries

# Required database bootstrap (secret; infrastructure-owned).
DATABASE_URL=postgresql://app:replace-with-password@db:5432/baseballstattrack?schema=public
DIRECT_URL=postgresql://app:replace-with-password@db:5432/baseballstattrack?schema=public

# Required authentication bootstrap. Client IDs and URLs are non-secret;
# encryption keys and client secrets remain in the external secret manager.
AUTHENTICATION_ENCRYPTION_KEY=replace-with-exactly-32-base64url-encoded-random-bytes
AUTHENTICATION_ENABLED_PROVIDERS=google
OAUTH_CALLBACK_URL=https://app.example.com/auth/callback
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret

# Conditional secrets. Supply only for the workers or integrations in use.
WEBHOOK_SIGNING_MASTER_KEY=replace-with-at-least-32-base64url-encoded-bytes
WEBHOOK_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_INGESTION_WORKER_TOKEN=replace-with-at-least-32-random-characters
EXTERNAL_DATA_PROVIDER_API_KEY=replace-with-managed-provider-api-key
EXTERNAL_DATA_PROVIDER_ALLOWED_ORIGIN=https://licensed-provider.example
ICS_FEED_SIGNING_KEY=replace-with-at-least-32-random-characters
NOTIFICATION_WORKER_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_EVENT_TOKEN=replace-with-a-different-32-character-token
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
NOTIFICATION_DISCORD_BOT_TOKEN=replace-with-managed-notification-bot-token
DISCORD_UPDATE_EVENT_TOKEN=replace-with-a-different-32-character-token
DISCORD_UPDATE_WORKER_TOKEN=replace-with-another-32-character-token
DISCORD_STATISTICS_API_TOKEN=replace-with-dedicated-report-view-token
DISCORD_UPDATE_BOT_TOKEN=replace-with-managed-update-bot-token
